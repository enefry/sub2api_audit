# Generate independent secrets, for example:
#   openssl rand -base64 48
AUDIT_PROXY_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
AUDIT_TOKEN_HMAC_KEY=base64:REPLACE_WITH_BASE64_RANDOM_KEY

AUDIT_DATA_DIR=/data
AUDIT_TEMP_DIR=/data/.tmp
AUDIT_TIMEZONE=Asia/Hong_Kong
# These users are audit administrators. Other Authentik users see only records
# whose resolved Sub2API username exactly matches their Authentik username.
AUDIT_USERNAME_ALLOWLIST=alice,bob
# AUDIT_USERNAME_ALLOWLIST_FILE=/run/secrets/audit_admins
AUDIT_MAX_BODY_BYTES=268435456
AUDIT_BODY_CHUNK_BYTES=1048576
AUDIT_SQLITE_BUSY_TIMEOUT_MS=5000
AUDIT_QUERY_MAX_DAYS=90
AUDIT_READ_WORKERS=2
AUDIT_CACHE_BYTES=134217728
AUDIT_FULL_CACHE_TTL_SECONDS=120

# This account must have SELECT on api_keys/users only and default read-only mode.
SUB2API_READONLY_DSN=postgresql://sub2api_audit_reader:REPLACE_PASSWORD@sub2api_postgres:5432/sub2api
SUB2API_POSTGRES_TIMEOUT_SECONDS=2
SUB2API_TOKEN_CACHE_SECONDS=300

AUDIT_ARCHIVE_ENABLED=true
AUDIT_S3_ENDPOINT=https://s3.example.invalid
AUDIT_S3_REGION=auto
AUDIT_S3_BUCKET=sub2api-audit
AUDIT_S3_PREFIX=production/sub2api
AUDIT_S3_ACCESS_KEY_ID=REPLACE_ACCESS_KEY
AUDIT_S3_SECRET_ACCESS_KEY=REPLACE_SECRET_KEY
AUDIT_ARCHIVE_KEY=base64:REPLACE_WITH_EXACTLY_32_RANDOM_BYTES_BASE64
AUDIT_ARCHIVE_KEY_ID=sub2api-audit-2026-01
AUDIT_ARCHIVE_RETRY_INITIAL_SECONDS=60
AUDIT_ARCHIVE_RETRY_MAX_SECONDS=3600
